# Etsy OAuth 2.0 (API v3) — https://www.etsy.com/developers/your-apps
# Etsy uses Authorization Code + PKCE; there is NO client secret.

# App "keystring" from your Etsy app settings. Sent as OAuth client_id.
ETSY_CLIENT_ID=

# App "shared secret" from the Etsy app page. Optional for OAuth (PKCE), but
# some keys are rejected as a bare keystring and need the x-api-key header to be
# "keystring:shared_secret" — set this and etsyFetch sends the combined value.
ETSY_SHARED_SECRET=

# Must match a redirect URI registered on the Etsy app exactly.
ETSY_REDIRECT_URI=http://localhost:3000/api/auth/etsy/callback

# Space-separated Etsy scopes. Default: listings_r listings_w shops_r
# Full list: https://developers.etsy.com/documentation/essentials/authentication#scopes
#
# Deleting listings (the listings page's Delete action) additionally needs
# `listings_d` — Etsy answers 403 without it. Add it here AND reconnect the
# shop (scopes are fixed when the token is issued, so an existing connection
# keeps the scopes it was granted):
#   ETSY_SCOPES=listings_r listings_w listings_d shops_r
ETSY_SCOPES=listings_r listings_w shops_r

# Secret for encrypting the session cookie (AES-256-GCM). Min 32 chars.
# Generate: openssl rand -base64 32
ETSY_OAUTH_SESSION_SECRET=

# Auth.js (app accounts — email/password sign-in, see auth.ts). Signs session
# JWTs. Unrelated to the Etsy secrets above — this app account is separate
# from any Etsy connection. Generate: openssl rand -base64 32
AUTH_SECRET=

# Encrypts each account's two-factor (TOTP) secret at rest — AES-256-GCM, the
# same scheme as the stored Etsy refresh token but deliberately its own key
# (lib/auth/two-factor-key.ts). Min 32 chars. Without it, enabling 2FA is
# unavailable and 2FA sign-ins fail with a clear server-side error. Rotating it
# invalidates every stored secret: affected users sign in with a recovery code,
# then disable and re-enable 2FA. Generate: openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY=

# Neon Postgres (https://console.neon.tech) — used to persist mockup print-area
# calibrations (lib/mockup/calibration-store.ts), via Prisma + @prisma/adapter-neon.
# DATABASE_URL: the POOLED connection string (has "-pooler" in the host) — the
#   app's runtime connection.
# DIRECT_URL: the UNPOOLED connection string — used only by `prisma migrate` /
#   `prisma db push` (PgBouncer's transaction pooling can't run the
#   session-level statements migrations need).
# Both are on your Neon project's Dashboard -> Connect page.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# Cloudflare R2 (https://dash.cloudflare.com -> R2) — used to store saved-draft
# binary files (uploaded PSDs, design images, own photos, thumbnail; see
# lib/storage/r2.ts, lib/drafts/*). R2 speaks the S3 API, so this is read by
# @aws-sdk/client-s3 with region "auto" and an R2-specific endpoint.
# R2_ACCOUNT_ID: your Cloudflare account id (dashboard URL, or Workers & Pages
#   overview page).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: from an R2 API token
#   (dashboard -> R2 -> Manage API tokens -> Create API token).
# R2_BUCKET: the bucket name (dashboard -> R2 -> create a bucket if needed).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: guards POST /api/drafts/sweep (an external cron endpoint for
# expired-draft cleanup) with `Authorization: Bearer <secret>`. Unset = open —
# safe either way, since the route only ever deletes already-expired drafts.
DRAFT_SWEEP_SECRET=

# Required to run scheduled listings: the shared secret guarding
# POST /api/schedule/run (the scheduled-listing runner). Callers send
# `Authorization: Bearer <secret>`; while unset, the endpoint refuses every
# request. `npm run schedule:run` reads it from .env.local.
# Generate: openssl rand -base64 32
SCHEDULE_RUNNER_SECRET=

# Optional: the app URL `npm run schedule:run` calls. Default http://localhost:3000.
SCHEDULE_RUNNER_URL=

# Claude API key for the bulk editor's AI Edits (Title/Description/Tags).
# Without it, Optimize and Regenerate report "AI Edits isn't set up" on each
# row; every other bulk edit works. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Who may open /admin/templates (the shared mockup template library) and call
# /api/admin/*. User ids, comma- or space-separated — not emails, since email
# addresses aren't verified. Unset = nobody; everyone else gets a 404.
# Find your id in `npm run db:studio` -> User.
ADMIN_USER_IDS=
