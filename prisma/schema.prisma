// Prisma schema — Neon Postgres.
//
// Prisma 7 moved connection URLs out of this file: `prisma.config.ts` gives
// the CLI (migrate/generate) `DIRECT_URL` (Neon's unpooled connection — the
// schema engine needs session-level statements PgBouncer's transaction
// pooling doesn't support), and the runtime `PrismaClient` gets `DATABASE_URL`
// (Neon's pooled connection) via the `@prisma/adapter-neon` driver adapter
// (see lib/db/prisma.ts). No `url` here — see the schema-validation error if
// you add one back.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// The app account. Password auth only (Auth.js Credentials provider) — we
/// never ask for or store an Etsy password; `passwordHash` is a bcrypt hash
/// (cost 12, see lib/auth/password.ts) of the account's own password.
///
/// This is the tenant boundary for everything a signed-in user owns: their
/// Etsy connection (bound into the sealed session cookie, see
/// lib/etsy/session.ts's `ownerUserId`) and every `ListingDraft` /
/// `MockupTemplate` / `MockupCalibration` row.
model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  emailVerified          DateTime?
  name                   String?
  /// Editable from /settings' "Contact information" card. Null until set.
  firstName              String?
  lastName               String?
  image                  String?
  /// "light" | "dark" (lib/account/theme.ts) — chosen in /settings. Rendered
  /// server-side as `<html data-theme>` by app/layout.tsx, so the stored
  /// theme is already applied in the first HTML byte (no flash). There is
  /// deliberately no "follow the OS" value.
  theme                  String    @default("light")
  /// Optional TOTP two-factor auth (lib/account/two-factor.ts). Secrets are
  /// AES-256-GCM encrypted with TWO_FACTOR_ENCRYPTION_KEY
  /// (lib/auth/two-factor-key.ts) — never stored in plain text.
  /// `twoFactorPendingSecret` holds a secret during setup, until a valid code
  /// promotes it to `twoFactorSecret`. `twoFactorLastUsedStep` is the TOTP time
  /// step of the last code accepted at sign-in, so a code can't be replayed.
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?
  twoFactorPendingSecret String?
  twoFactorLastUsedStep  Int?
  /// When the Terms of Service and Privacy Policy were accepted at sign-up.
  /// Null for accounts created before the checkbox existed.
  termsAcceptedAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  recoveryCodes                 TwoFactorRecoveryCode[]
  accounts                      Account[]
  sessions                      Session[]
  drafts                        ListingDraft[]
  calibrations                  MockupCalibration[]
  templates                     MockupTemplate[]
  shopConnections               EtsyShopConnection[]
  listings                      Listing[]
  scheduledListings             ScheduledListing[]
  listingImages                 ListingImage[]
  listingVideos                 ListingVideo[]
  listingInventoryProperties    ListingInventoryProperty[]
  listingInventoryValues        ListingInventoryValue[]
  listingInventoryProducts      ListingInventoryProduct[]
  listingInventoryProductValues ListingInventoryProductValue[]

  @@map("users")
}

/// A single-use two-factor recovery code. Ten are issued when 2FA is enabled
/// and shown to the user exactly once; only a SHA-256 hash is stored
/// (lib/auth/recovery-codes.ts — the codes carry ~50 bits of randomness, so
/// no slow hash is needed). `usedAt` is set atomically on use; a used code
/// never works again. All of a user's codes are deleted when 2FA is disabled.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("two_factor_recovery_codes")
}

/// Brute-force counters (lib/auth/throttle.ts), keyed by what they limit — a
/// sign-in email's SHA-256 (`login:<hash>`, whether or not an account has
/// that email, so a lock never reveals one exists), a client IP's failed
/// sign-ins (`login-ip:<ip>`) or sign-ups (`register-ip:<ip>`). `failures`
/// counts since the last lock (or the window start, for IP keys);
/// `lockLevel` is how many locks the key has had; `emailLocked` is set once
/// the 1-hour level is reached and is cleared only by an email unlock.
model AuthThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockLevel   Int       @default(0)
  lockedUntil DateTime?
  emailLocked Boolean   @default(false)
  windowStart DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("auth_throttles")
}

/// The Etsy API key's rate-limit state, shared by every user and every
/// server instance (lib/etsy/client.ts). One row, id "global": the limits and
/// remaining daily quota Etsy last reported, the current one-second window's
/// request count, and a pause every instance honours after a 429.
model EtsyRateLimit {
  id             String    @id
  perSecondLimit Int?
  perDayLimit    Int?
  remainingToday Int?
  observedAt     DateTime?
  windowStartMs  BigInt    @default(0)
  windowCount    Int       @default(0)
  pausedUntil    DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("etsy_rate_limit")
}

/// Auth.js Prisma adapter model — linked-account storage for non-credentials
/// providers. Unused today (Credentials is the only provider) but required
/// by the adapter's schema contract, and here for when a social provider is
/// added later.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Auth.js Prisma adapter model. Not read on the hot path — sessions use the
/// JWT strategy (required alongside Credentials), so this table only matters
/// if a database-session-backed provider is added later.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Auth.js Prisma adapter model — email verification / password reset
/// tokens. Not issued yet (no email flow wired up), required by the adapter.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// One saved mockup calibration (print-area corners + sliders), keyed by a
/// hash of the source PSD's bytes so the same template maps to the same
/// calibration regardless of filename. Scoped to the signed-in `User` who
/// saved it — not the Etsy account, which can be disconnected and
/// reconnected (possibly to a different shop) independently of the app account.
/// `data` is the `Calibration` shape from lib/mockup/types.ts, validated with
/// `coerceCalibration` before it is ever written.
model MockupCalibration {
  id          String   @id @default(cuid())
  userId      String
  contentHash String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentHash])
  @@index([userId])
  @@map("mockup_calibrations")
}

/// A user's in-progress listing draft — saved to our own DB, never to Etsy
/// (see memory `live-listing-never-auto-modified`). `formData` is the editor's
/// full `ListingFormValue` (app/mockups/ListingForm.tsx); `photosData` is the
/// `DraftPhotosData` shape from lib/drafts/types.ts (mockup/design/own-image
/// metadata, photo-grid order, alt text). The binary files themselves — PSDs,
/// design images, own photos, and a small thumbnail — live in R2 (lib/storage/r2.ts),
/// keyed deterministically as `drafts/{id}/{kind}/{itemId}`, not in this row.
/// `hasThumbnail` just records whether that thumbnail object exists, so the
/// drafts list can build its URL without a storage round trip.
///
/// Scoped to the signed-in `User`, not the Etsy account — see `MockupCalibration`.
model ListingDraft {
  id              String   @id @default(cuid())
  userId          String
  title           String   @default("")
  hasThumbnail    Boolean  @default(false)
  formData        Json
  photosData      Json
  /// The listing this draft was seeded from, if any — "copy" (publishes as a
  /// brand-new listing borrowing category/shipping/return-policy from
  /// `sourceListingId` at publish time, same as `getListingStructure`) or
  /// "existing" (publishes as an edit/addition to `sourceListingId` itself).
  /// Both null for a from-scratch draft. Persisted here — not just the
  /// editor URL's `mode`/`listingId` — so resuming from "My drafts" still
  /// knows it's a copy/edit instead of silently falling back to "new" and
  /// losing the category borrow. String, not Int: Etsy listing ids are
  /// already close to Int32's ~2.1B ceiling.
  sourceMode      String?
  sourceListingId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledListings ScheduledListing[]

  @@index([userId, updatedAt])
  @@map("listing_drafts")
}

/// A mockup template — either a curated library entry (`source: "library"`,
/// `ownerId: null`) backed by a flat JPEG/PNG in R2 under `templates/library/`, or a
/// user's own uploaded JPEG/PNG (`source: "user"`, `ownerId` the signed-in
/// `User` who uploaded it — not their Etsy account, see `MockupCalibration`)
/// stored in R2 (see lib/storage/r2.ts). Library rows are keyed by their
/// library filename; user rows get a generated, globally-unique `filename`
/// used as their R2 object key (lib/mockup/template-store.ts) — it never
/// collides with a library filename or another user's upload.
///
/// `quad` is the print-area corners the compositor warps a design onto — the
/// `Quad` shape from lib/mockup/types.ts, validated with `toQuad` before it is
/// ever written. `calibrated` is false until a save (from /admin/templates for
/// a library row, or the same calibration UI reused for a user's own upload)
/// sets a deliberate quad; until then the template renders with `DEFAULT_QUAD`.
model MockupTemplate {
  id          String   @id @default(cuid())
  /// The signed-in User who uploaded this template, or null for a curated
  /// library template.
  ownerId     String?
  /// "library" (curated, R2 templates/library/) or "user" (uploaded, R2 templates/user/).
  source      String   @default("library")
  filename    String   @unique
  name        String
  productType String
  colour      String
  dpiHint     Int      @default(300)
  quad        Json
  calibrated  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("mockup_templates")
}

/// One Etsy shop the signed-in `User` has connected via OAuth. A user can
/// connect more than one — each gets its own row here — so they can switch
/// between shops without losing the others' connection (see the listings
/// page's "Switch shop" refresh control). `etsyUserId` is the numeric Etsy
/// user id (the prefix of every access token, see lib/etsy/oauth.ts's
/// `userIdFromToken`) — comparing it against the live session cookie's
/// `userId` is how the app knows which connection is "active" right now
/// without an extra Etsy API call. `refreshToken` is encrypted at rest with
/// the same AES-256-GCM scheme as the session cookie (lib/etsy/token-crypto.ts),
/// keyed by `ETSY_OAUTH_SESSION_SECRET` — rotated every time it's used
/// (Etsy issues a new refresh token on every refresh grant).
model EtsyShopConnection {
  id              String    @id @default(cuid())
  userId          String
  etsyUserId      String
  shopId          String
  shopName        String
  shopIconUrl     String?
  refreshToken    String
  /// Set after the first successful listings sync for this shop; null means
  /// the listings page has never been populated from Etsy yet.
  lastSyncedAt    DateTime?
  lastConnectedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
  @@map("etsy_shop_connections")
}

/// A DB-backed cache of one shop's Etsy listings, kept in sync by the
/// listings page's on-demand "Refresh" action (lib/etsy/listing-sync.ts) —
/// Etsy itself is always the source of truth, this table just lets the
/// listings page render instantly instead of live-querying Etsy on every
/// view. Scoped by `userId` + `shopId` (a user can have rows for more than
/// one connected shop, see `EtsyShopConnection`); unique per Etsy
/// `listingId` within that scope so a refresh can upsert by id.
/// `removedAt` is set (never deleted) when a refresh no longer finds the
/// listing on Etsy in any state — keeps the row's history instead of
/// silently dropping it, and lets a listing that reappears be revived by
/// clearing it back to null on the next matching upsert.
model Listing {
  id            String    @id @default(cuid())
  userId        String
  shopId        String
  listingId     String
  title         String
  state         String
  url           String
  quantity      Int
  price         String?
  thumbnailUrl  String?
  endingAt      DateTime?
  shopSectionId Int?
  sku           String?
  removedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  description                 String?
  tags                        String[]  @default([])
  materials                   String[]  @default([])
  /// "physical" | "download" | "both"
  listingType                 String?
  /// "i_did" | "someone_else" | "collective"
  whoMade                     String?
  whenMade                    String?
  isSupply                    Boolean?
  /// Etsy Money: `priceAmount / priceDivisor` in `currencyCode`.
  priceAmount                 Int?
  priceDivisor                Int?
  currencyCode                String?
  shippingProfileId           String?
  returnPolicyId              String?
  itemWeight                  Float?
  itemWeightUnit              String?
  itemLength                  Float?
  itemWidth                   Float?
  itemHeight                  Float?
  itemDimensionsUnit          String?
  processingMin               Int?
  processingMax               Int?
  isPersonalizable            Boolean   @default(false)
  personalizationIsRequired   Boolean   @default(false)
  personalizationInstructions String?
  personalizationCharCountMax Int?
  syncedAt                    DateTime?

  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  images              ListingImage[]
  videos              ListingVideo[]
  inventoryProperties ListingInventoryProperty[]
  inventoryProducts   ListingInventoryProduct[]

  @@unique([userId, shopId, listingId])
  @@index([userId, shopId, state])
  @@map("listings")
}

/// One photo of a cached `Listing`, in Etsy's rank order.
model ListingImage {
  id           String   @id @default(cuid())
  userId       String
  listingRowId String
  etsyImageId  String?
  url          String
  altText      String?
  rank         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingRowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listingRowId, rank])
  @@map("listing_images")
}

/// One video of a cached `Listing`, in slot order.
model ListingVideo {
  id           String   @id @default(cuid())
  userId       String
  listingRowId String
  etsyVideoId  String?
  url          String
  thumbnailUrl String?
  rank         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingRowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listingRowId, rank])
  @@map("listing_videos")
}

/// A variation property (e.g. "Size") of a cached `Listing`'s inventory grid.
model ListingInventoryProperty {
  id                 String   @id @default(cuid())
  userId             String
  listingRowId       String
  etsyPropertyId     String
  name               String
  scaleId            String?
  scaleName          String?
  rank               Int
  priceOnProperty    Boolean  @default(false)
  quantityOnProperty Boolean  @default(false)
  skuOnProperty      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing                 @relation(fields: [listingRowId], references: [id], onDelete: Cascade)
  values  ListingInventoryValue[]

  @@unique([listingRowId, etsyPropertyId])
  @@index([userId])
  @@map("listing_inventory_properties")
}

/// One option (e.g. "Large") of a `ListingInventoryProperty`.
model ListingInventoryValue {
  id          String   @id @default(cuid())
  userId      String
  propertyId  String
  etsyValueId String?
  value       String
  rank        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  property ListingInventoryProperty       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  products ListingInventoryProductValue[]

  @@index([userId])
  @@index([propertyId, rank])
  @@map("listing_inventory_values")
}

/// One combination of a cached `Listing`'s inventory grid, with its own
/// price, quantity, SKU and visibility (Etsy's product + its offering).
model ListingInventoryProduct {
  id               String   @id @default(cuid())
  userId           String
  listingRowId     String
  etsyProductId    String?
  etsyOfferingId   String?
  sku              String?
  priceAmount      Int
  priceDivisor     Int
  currencyCode     String
  quantity         Int
  isEnabled        Boolean  @default(true)
  readinessStateId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing                        @relation(fields: [listingRowId], references: [id], onDelete: Cascade)
  values  ListingInventoryProductValue[]

  @@index([userId])
  @@index([listingRowId])
  @@map("listing_inventory_products")
}

/// Which property value a `ListingInventoryProduct` combination takes.
model ListingInventoryProductValue {
  userId    String
  productId String
  valueId   String

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product ListingInventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  value   ListingInventoryValue   @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productId, valueId])
  @@index([userId])
  @@index([valueId])
  @@map("listing_inventory_product_values")
}

/// A listing the user has asked to publish to Etsy at a later time
/// (lib/scheduling/store.ts). Scheduling never talks to Etsy — the listing's
/// content stays a `ListingDraft` in our own DB until a background runner
/// (not built yet) picks the row up at `scheduledAt` and publishes it.
///
/// Refers to the saved `ListingDraft` it was scheduled from. `draftId` is SET
/// NULL on draft deletion so a published row's history survives; deleting a
/// draft cancels its still-active schedules first (lib/drafts/store.ts's
/// `deleteDraft`).
///
/// Scoped to the owning `User` *and* the Etsy `shopId` it will publish to —
/// every read and write filters on both.
///
/// `scheduledAt` is the UTC instant. `timezone` is the IANA zone the user
/// picked it in, kept so the time can be shown and edited back in that zone.
/// `status` is "pending" | "publishing" | "published" | "failed" |
/// "cancelled" (lib/scheduling/types.ts).
///
/// Everything the runner (lib/scheduling/runner.ts) sends to Etsy is fixed
/// at schedule time: `publishSpec` is the validated listing content (the
/// editor's Publish payload, lib/scheduling/publish-spec.ts) and `images`
/// the ordered R2 keys of the images the browser rendered and uploaded then
/// (`ScheduledImage[]`, all under `scheduled/{userId}/{renderSetId}/` — see
/// lib/scheduling/render-keys.ts). The runner never composites anything.
///
/// `activeDraftId` mirrors `draftId` while the row is pending, publishing or
/// failed and is null otherwise — its unique index is the database-level
/// guarantee that a draft has at most one active schedule.
///
/// Runner bookkeeping: `attemptCount` counts failed publish attempts (3 →
/// "failed"), `nextAttemptAt` holds a retry back until its backoff passes,
/// `lastError` is the latest failure, and `etsyListingId` is set as soon as
/// Etsy creates the listing, so a retry finishes that listing instead of
/// creating a duplicate.
model ScheduledListing {
  id            String    @id @default(cuid())
  userId        String
  shopId        String
  draftId       String?
  activeDraftId String?   @unique
  scheduledAt   DateTime
  timezone      String
  status        String    @default("pending")
  /// "publish" (a draft becomes a new Etsy listing) or "bulk_edit" (pending
  /// bulk-editor changes applied to listings that are already live).
  kind          String    @default("publish")
  publishSpec   Json?
  /// A bulk edit's per-listing patches, fixed when it was scheduled.
  bulkEdit      Json?
  /// What the runner's last pass did, per listing — the same per-listing
  /// outcomes Sync updates reports on screen.
  results       Json?
  renderSetId   String?
  images        Json      @default("[]")
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  etsyListingId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft ListingDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([userId, shopId, scheduledAt])
  @@index([draftId])
  @@map("scheduled_listings")
}
